@page "/trace/{MaLo}"
@layout FarmNet.Client.Layout.LoginLayout
@inject HttpClient Http

<PageTitle>Truy xuất nguồn gốc - @MaLo</PageTitle>

<div class="min-h-screen bg-gradient-to-b from-green-50 to-white">
    <!-- Header -->
    <div class="bg-green-700 text-white py-6 px-4">
        <div class="max-w-2xl mx-auto flex items-center gap-3">
            <i class="fas fa-leaf text-green-300 text-2xl"></i>
            <div>
                <h1 class="text-xl font-bold">FarmNet</h1>
                <p class="text-green-200 text-sm">Truy xuất nguồn gốc nông sản</p>
            </div>
        </div>
    </div>

    <div class="max-w-2xl mx-auto p-4 space-y-6">
        @if (_loading)
        {
            <div class="flex flex-col items-center py-16">
                <div class="w-10 h-10 border-4 border-green-500 border-t-transparent rounded-full animate-spin mb-4"></div>
                <p class="text-gray-500">Đang tải thông tin lô @MaLo...</p>
            </div>
        }
        else if (_data == null)
        {
            <div class="text-center py-16">
                <i class="fas fa-box-open text-gray-300 text-5xl mb-4"></i>
                <p class="text-gray-500 text-lg">Không tìm thấy thông tin lô sản phẩm</p>
                <p class="text-gray-400 text-sm mt-1">Mã lô: @MaLo</p>
            </div>
        }
        else
        {
            <!-- Product Info -->
            <div class="bg-white rounded-2xl shadow-sm border border-green-100 p-6">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-14 h-14 bg-green-100 rounded-full flex items-center justify-center">
                        <i class="fas fa-seedling text-green-600 text-2xl"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-gray-800">@_data.TenSanPham</h2>
                        <p class="text-sm text-gray-500 font-mono">Mã lô: @_data.MaLo</p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div class="bg-gray-50 rounded-lg p-3">
                        <p class="text-gray-400 text-xs mb-1">Trang trại</p>
                        <p class="font-semibold text-gray-800">@_data.TenFarm</p>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-3">
                        <p class="text-gray-400 text-xs mb-1">Trạng thái</p>
                        <p class="font-semibold text-green-700">@_data.TrangThai</p>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-3 col-span-2">
                        <p class="text-gray-400 text-xs mb-1">Địa chỉ trang trại</p>
                        <p class="text-gray-700">@_data.DiaChiFarm</p>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-3">
                        <p class="text-gray-400 text-xs mb-1">Ngày tạo lô</p>
                        <p class="font-medium text-gray-700">@_data.NgayTao.ToString("dd/MM/yyyy")</p>
                    </div>
                    @if (_data.ThuHoach != null)
                    {
                        <div class="bg-green-50 rounded-lg p-3">
                            <p class="text-gray-400 text-xs mb-1">Ngày thu hoạch</p>
                            <p class="font-medium text-green-700">@_data.ThuHoach.NgayThuHoach.ToString("dd/MM/yyyy")</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Harvest -->
            @if (_data.ThuHoach != null)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-orange-100 p-6">
                    <h3 class="font-bold text-gray-700 mb-3 flex items-center gap-2">
                        <i class="fas fa-leaf text-orange-500"></i>Thông tin thu hoạch
                    </h3>
                    <div class="grid grid-cols-2 gap-3 text-sm">
                        <div><span class="text-gray-400">Trọng lượng: </span><strong>@_data.ThuHoach.TrongLuong kg</strong></div>
                        @if (!string.IsNullOrEmpty(_data.ThuHoach.GhiChuChatLuong))
                        {
                            <div class="col-span-2"><span class="text-gray-400">Chất lượng: </span>@_data.ThuHoach.GhiChuChatLuong</div>
                        }
                    </div>
                </div>
            }

            <!-- Farming Logs -->
            @if (_data.NhatKyCanhTac.Any())
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <h3 class="font-bold text-gray-700 mb-4 flex items-center gap-2">
                        <i class="fas fa-clipboard-list text-blue-500"></i>Nhật ký canh tác (@_data.NhatKyCanhTac.Count hoạt động)
                    </h3>
                    <div class="space-y-3 max-h-80 overflow-y-auto">
                        @foreach (var log in _data.NhatKyCanhTac)
                        {
                            <div class="flex items-start gap-3 border-b border-gray-50 pb-3">
                                <div class="w-2 h-2 bg-green-400 rounded-full mt-2 flex-shrink-0"></div>
                                <div>
                                    <p class="font-medium text-gray-800 text-sm">@log.HoatDong</p>
                                    @if (!string.IsNullOrEmpty(log.GhiChu))
                                    {
                                        <p class="text-gray-500 text-xs">@log.GhiChu</p>
                                    }
                                    <p class="text-xs text-gray-400 mt-0.5">@log.NgayThucHien.ToString("dd/MM/yyyy")</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Blockchain Verification -->
            <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 p-6">
                <h3 class="font-bold text-gray-700 mb-4 flex items-center gap-2">
                    <i class="fas fa-shield-alt text-indigo-500"></i>Xác minh Blockchain
                </h3>
                @if (_data.BlockchainRecords.Any())
                {
                    <div class="space-y-2">
                        @foreach (var record in _data.BlockchainRecords)
                        {
                            <div class="flex items-center gap-3 p-3 bg-indigo-50 rounded-lg">
                                <i class="fas @(record.DaXacNhan ? "fa-check-circle text-green-500" : "fa-clock text-yellow-400") text-sm"></i>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-700">@record.TenSuKien</p>
                                    @if (!string.IsNullOrEmpty(record.TxHash))
                                    {
                                        <p class="text-xs text-indigo-600 font-mono truncate">@record.TxHash</p>
                                    }
                                </div>
                                <span class="text-xs text-gray-400">@record.ThoiGian.ToString("dd/MM")</span>
                            </div>
                        }
                    </div>
                    <p class="text-xs text-gray-400 mt-3 text-center">
                        <i class="fas fa-info-circle mr-1"></i>Dữ liệu được ghi và xác minh trên mạng Ethereum Testnet
                    </p>
                }
                else
                {
                    <p class="text-gray-400 text-center text-sm">Chưa có bản ghi blockchain</p>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string MaLo { get; set; } = "";
    private TraceabilityDto? _data;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var response = await Http.GetAsync($"api/public/trace/{MaLo}");
        if (response.IsSuccessStatusCode)
            _data = await response.Content.ReadFromJsonAsync<TraceabilityDto>();
        _loading = false;
    }
}
